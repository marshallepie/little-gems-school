# Public, browser-safe Supabase settings. Obtain these from your local `supabase status`
# output or from an approved Supabase project. Do not put a service-role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-approved-project-publishable-key
